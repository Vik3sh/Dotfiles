 /* wallust template - colors-rofi */

* {
active-background: #E5A9BD;
active-foreground: #FDF9EC;
normal-background: #2A1F1D;
normal-foreground: #FDF9EC;
urgent-background: #D5C2C1;
urgent-foreground: #FDF9EC;

alternate-active-background: #D3A7D3;
alternate-active-foreground: #FDF9EC;
alternate-normal-background: #2A1F1D;
alternate-normal-foreground: #FDF9EC;
alternate-urgent-background: #2A1F1D;
alternate-urgent-foreground: #FDF9EC;

selected-active-background: #E5A9BD;
selected-active-foreground: #2A1F1D;
selected-normal-background: #E5A9BD;
selected-normal-foreground: #2A1F1D;
selected-urgent-background: #D3A7D3;
selected-urgent-foreground: #2A1F1D;

background-color: #2A1F1D;
background: rgba(0,0,0,0.7);
foreground: #FDF9EC;
border-color: #E5A9BD;

color0: #524542;
color1: #638B7B;
color2: #738974;
color3: #9E7D9E;
color4: #AC7E8E;
color5: #A09291;
